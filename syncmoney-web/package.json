{
  "name": "syncmoney-web",
  "private": true,
  "version": "1.4.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:embedded": "node scripts/build-embedded.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.68.0",
    "@tanstack/vue-virtual": "^3.13.52",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.21.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "motion-v": "^2.11.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "happy-dom": "^21.0.4",
    "msw": "^2.0.0",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
