{
  "name": "syncmoney-web",
  "private": true,
  "version": "1.3.2",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:embedded": "node scripts/build-embedded.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.39",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.18.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-vue-next": "^0.576.0",
    "motion-v": "^2.5.1",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^20.8.9",
    "msw": "^2.0.0",
    "postcss": "^8.5.23",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
